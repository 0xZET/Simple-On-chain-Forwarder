# Private key of the monitored address (with or without 0x)
PRIVATE_KEY=

# Address that receives the funds
RECIPIENT_ADDRESS=

# Alchemy RPC for Base (the URL contains your API key: keep this file private)
BASE_RPC=

# Check interval in seconds: 0.1 = 10 checks per second (minimum 0.05)
CHECK_INTERVAL=0.1

# Percent of each incoming amount to leave on the address (fractions allowed: 0.5)
KEEP_PERCENT=1

# Gas price premium in percent: 20 = gas price +20% above the network price
GAS_PREMIUM_PERCENT=20

# What to do with the balance that is already on the address at start:
#   false = ignore it, forward only funds that arrive after start (default)
#   true  = forward it too (KEEP_PERCENT is still left on the address)
SWEEP_EXISTING_ON_START=false

# Folder for daily log files (relative to the script folder or absolute)
LOG_DIR=logs

# Which block state the balance is read from:
#   latest  = confirmed blocks only (default, works everywhere, new block every ~2 s)
#   pending = preconfirmed state (~200 ms on RPCs with Flashblocks support, see below)
# Use "pending" only if your provider supports Base Flashblocks: check with --dry-run first.
BALANCE_BLOCK=pending


# Extra nonce added to the local nonce counter at the moment a deposit is detected (whole number, 0-10).
# Use it when the monitored address itself sends transactions (e.g. a contract call, +1 nonce)
# right before the contract pays ETH back, and the local counter has not seen them yet.
#   0 = off (default)
#   1 = send with local nonce + 1
# With NONCE_EXTRA >= 1 the nonce is read from the network only once at start and then counted
# locally (the 3-second background nonce refresh is OFF). With 0 it is refreshed as before.
# After a send error the nonce is re-read from the network and used as-is (no extra on that retry).
# WARNING: every deposit must be preceded by exactly NONCE_EXTRA own transactions of this address.
# Otherwise the forwarder's transaction gets stuck behind a nonce gap (restart the script to fix).
NONCE_EXTRA=0

